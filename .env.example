# Solo server. Non usare mai prefissi VITE_ per queste variabili.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=4000
OPENAI_SERVICE_TIER=fast

# Configurare in base al modello scelto per mostrare una stima dei costi.
OPENAI_INPUT_COST_PER_MILLION=0.20
OPENAI_OUTPUT_COST_PER_MILLION=1.00
